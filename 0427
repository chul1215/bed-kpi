<!DOCTYPE html>

<html lang="ko">
<head>
<meta charset="UTF-8">
<title>대전선병원 홍보팀 4월 업무진행 사항 보고</title>
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
<style>
  :root{
    --ink:#111111;
    --ink-2:#2b2b2b;
    --gray-1:#5a5a5a;
    --gray-2:#8a8a8a;
    --gray-3:#bdbdbd;
    --line:#e5e5e5;
    --line-2:#ededed;
    --bg:#ffffff;
    --bg-soft:#fafafa;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{
    background:#eaeaea;
    font-family:'Pretendard Variable', Pretendard, -apple-system, system-ui, sans-serif;
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
    font-feature-settings:"ss01","tnum";
  }
  .deck{
    display:flex;flex-direction:column;align-items:center;
    padding:40px 20px;gap:28px;
  }
  .slide{
    width:1280px;height:720px;
    background:var(--bg);
    position:relative;
    overflow:hidden;
    box-shadow:0 1px 0 rgba(0,0,0,.04), 0 20px 40px -20px rgba(0,0,0,.18);
  }
  /* 공통 헤더/푸터 */
  .topbar{
    position:absolute;top:32px;left:64px;right:64px;
    display:flex;justify-content:space-between;align-items:center;
    font-size:11px;letter-spacing:.18em;color:var(--gray-2);
    text-transform:uppercase;
    border-bottom:1px solid var(--line);
    padding-bottom:14px;
  }
  .topbar .brand{font-weight:700;color:var(--ink)}
  .footer{
    position:absolute;bottom:28px;left:64px;right:64px;
    display:flex;justify-content:space-between;align-items:center;
    font-size:11px;letter-spacing:.16em;color:var(--gray-2);
    border-top:1px solid var(--line);padding-top:14px;
    text-transform:uppercase;
  }
  .pagenum{font-variant-numeric:tabular-nums;font-weight:600;color:var(--ink-2)}

/* 표지 */
.cover{
padding:96px 64px;
display:flex;flex-direction:column;justify-content:space-between;
height:100%;
}
.cover .meta{
font-size:12px;letter-spacing:.32em;color:var(–gray-1);
text-transform:uppercase;
}
.cover .titlewrap{margin-top:auto;margin-bottom:auto}
.cover .eyebrow{
font-size:13px;letter-spacing:.4em;color:var(–gray-1);
margin-bottom:28px;text-transform:uppercase;font-weight:500;
}
.cover h1{
font-size:84px;font-weight:800;line-height:1.04;
letter-spacing:-0.035em;color:var(–ink);
}
.cover h1 .light{font-weight:300;color:var(–gray-1)}
.cover .rule{
width:120px;height:2px;background:var(–ink);
margin:36px 0 24px;
}
.cover .sub{
font-size:18px;color:var(–gray-1);font-weight:400;
letter-spacing:-0.01em;
}
.cover .bottom{
display:flex;justify-content:space-between;align-items:flex-end;
font-size:12px;letter-spacing:.2em;color:var(–gray-2);
text-transform:uppercase;
}
.cover .bottom .big{
font-size:140px;font-weight:200;line-height:.9;color:var(–ink);
letter-spacing:-0.04em;
}

/* 일반 콘텐츠 슬라이드 */
.body{
padding:96px 64px 88px;
height:100%;
display:flex;flex-direction:column;
}
.section-num{
font-size:11px;letter-spacing:.32em;color:var(–gray-2);
font-weight:600;text-transform:uppercase;margin-bottom:14px;
}
h2{
font-size:42px;font-weight:800;letter-spacing:-0.025em;
color:var(–ink);line-height:1.1;
}
h2 .accent{font-weight:300;color:var(–gray-1)}
.lede{
font-size:14px;color:var(–gray-1);margin-top:14px;
letter-spacing:-0.005em;line-height:1.55;max-width:760px;
}
.divider{height:1px;background:var(–line);margin:28px 0}

/* KPI 테이블 */
table.kpi{
width:100%;border-collapse:collapse;
font-variant-numeric:tabular-nums;
}
table.kpi thead th{
text-align:left;font-size:11px;letter-spacing:.18em;
color:var(–gray-2);font-weight:600;text-transform:uppercase;
padding:14px 12px;border-bottom:1.5px solid var(–ink);
}
table.kpi tbody td{
padding:18px 12px;border-bottom:1px solid var(–line);
font-size:15px;color:var(–ink-2);
}
table.kpi tbody td.label{font-weight:600;color:var(–ink)}
table.kpi tbody td.num{text-align:right;font-weight:500}
table.kpi tbody td.rate{text-align:right;font-weight:700;color:var(–ink)}
.badge{
display:inline-block;padding:4px 10px;font-size:11px;
letter-spacing:.06em;font-weight:600;
border:1px solid var(–ink);color:var(–ink);
}
.badge.miss{border-color:var(–gray-2);color:var(–gray-1)}
.badge.over{background:var(–ink);color:#fff}

/* YoY 그리드 */
.yoy-grid{
display:grid;grid-template-columns:repeat(5, 1fr);
gap:0;border-top:1.5px solid var(–ink);
border-bottom:1px solid var(–line);
}
.yoy-cell{
padding:24px 18px;border-right:1px solid var(–line);
display:flex;flex-direction:column;gap:10px;
}
.yoy-cell:last-child{border-right:none}
.yoy-cell .k{
font-size:11px;letter-spacing:.18em;color:var(–gray-2);
font-weight:600;text-transform:uppercase;
}
.yoy-cell .v{
font-size:36px;font-weight:800;letter-spacing:-0.03em;
line-height:1;font-variant-numeric:tabular-nums;
color:var(–ink);
}
.yoy-cell .v .pm{font-size:18px;font-weight:600;color:var(–gray-1);margin-right:2px}
.yoy-cell .compare{
font-size:12px;color:var(–gray-1);
font-variant-numeric:tabular-nums;line-height:1.4;
}
.yoy-cell .compare b{color:var(–ink-2);font-weight:600}

/* 경쟁 순위 */
.rank-wrap{display:grid;grid-template-columns:1.2fr 1fr;gap:64px;margin-top:8px}
.rank-list{display:flex;flex-direction:column}
.rank-row{
display:grid;grid-template-columns:48px 1fr auto;
align-items:center;gap:18px;
padding:18px 0;border-bottom:1px solid var(–line);
}
.rank-row.top{border-bottom:1.5px solid var(–ink)}
.rank-row .pos{
font-size:22px;font-weight:300;color:var(–gray-2);
font-variant-numeric:tabular-nums;letter-spacing:-0.02em;
}
.rank-row.top .pos{color:var(–ink);font-weight:800;font-size:28px}
.rank-row .name{font-size:16px;color:var(–ink-2);font-weight:500}
.rank-row.top .name{font-weight:800;color:var(–ink);font-size:18px}
.rank-row .val{
font-size:18px;font-weight:700;color:var(–ink);
font-variant-numeric:tabular-nums;letter-spacing:-0.01em;
}
.rank-row.ref{opacity:.55;border-bottom-style:dashed}
.rank-row.ref .pos{font-size:11px;letter-spacing:.16em;text-transform:uppercase}

.rank-callout{
align-self:start;padding:32px;
border:1px solid var(–ink);
display:flex;flex-direction:column;gap:14px;
background:var(–bg-soft);
}
.rank-callout .k{
font-size:11px;letter-spacing:.24em;color:var(–gray-1);
font-weight:600;text-transform:uppercase;
}
.rank-callout .big{
font-size:64px;font-weight:800;line-height:.95;
letter-spacing:-0.04em;color:var(–ink);
font-variant-numeric:tabular-nums;
}
.rank-callout .desc{font-size:13px;color:var(–gray-1);line-height:1.55}

/* 누적 추이 */
table.trend{
width:100%;border-collapse:collapse;
font-variant-numeric:tabular-nums;
}
table.trend thead th{
text-align:right;font-size:11px;letter-spacing:.16em;
color:var(–gray-2);font-weight:600;text-transform:uppercase;
padding:12px 10px;border-bottom:1.5px solid var(–ink);
}
table.trend thead th:first-child{text-align:left}
table.trend tbody td{
padding:14px 10px;border-bottom:1px solid var(–line);
font-size:14px;color:var(–ink-2);text-align:right;
}
table.trend tbody td:first-child{text-align:left;font-weight:600;color:var(–ink)}
table.trend tbody td.acc{font-weight:700;color:var(–ink);background:var(–bg-soft)}
table.trend tbody td.delta{font-weight:700;color:var(–ink)}

/* 아이템 슬라이드 */
.items-grid{
display:grid;grid-template-columns:1fr 1fr;gap:36px 48px;
margin-top:8px;
}
.item{
display:flex;flex-direction:column;gap:10px;
padding-top:18px;border-top:1.5px solid var(–ink);
}
.item .tag{
font-size:11px;letter-spacing:.2em;color:var(–gray-2);
font-weight:600;text-transform:uppercase;
}
.item .name{
font-size:18px;font-weight:800;color:var(–ink);
letter-spacing:-0.015em;line-height:1.3;
}
.item .name .role{font-weight:400;color:var(–gray-1);font-size:14px;margin-left:6px}
.item ul{list-style:none;display:flex;flex-direction:column;gap:6px;margin-top:6px}
.item ul li{
font-size:13px;color:var(–ink-2);line-height:1.55;
padding-left:14px;position:relative;
}
.item ul li::before{
content:””;position:absolute;left:0;top:9px;
width:6px;height:1px;background:var(–gray-1);
}
.item ul li b{font-weight:700;color:var(–ink)}
.item ul li.done::after{
content:“완료”;font-size:10px;letter-spacing:.1em;
color:var(–gray-2);margin-left:8px;font-weight:600;
}

/* 신규 기획 카드 */
.plans-grid{
display:grid;grid-template-columns:repeat(3, 1fr);gap:24px;
margin-top:8px;
}
.plan{
border:1px solid var(–line);padding:28px 24px;
display:flex;flex-direction:column;gap:14px;
background:#fff;
transition:none;
}
.plan .num{
font-size:11px;letter-spacing:.24em;color:var(–gray-2);
font-weight:700;
}
.plan .ttl{
font-size:18px;font-weight:800;color:var(–ink);
letter-spacing:-0.015em;line-height:1.3;
}
.plan ul{list-style:none;display:flex;flex-direction:column;gap:6px;margin-top:6px}
.plan ul li{
font-size:13px;color:var(–ink-2);line-height:1.55;
padding-left:14px;position:relative;
}
.plan ul li::before{
content:””;position:absolute;left:0;top:9px;
width:6px;height:1px;background:var(–gray-1);
}
.plan.dark{background:var(–ink);border-color:var(–ink);color:#fff}
.plan.dark .num{color:var(–gray-3)}
.plan.dark .ttl{color:#fff}
.plan.dark ul li{color:#dcdcdc}
.plan.dark ul li::before{background:var(–gray-2)}

/* 마무리 */
.end{
padding:96px 64px;height:100%;
display:flex;flex-direction:column;justify-content:space-between;
}
.end h2{font-size:64px;font-weight:200;letter-spacing:-0.035em;line-height:1.1}
.end h2 b{font-weight:800}
.end .meta{
font-size:12px;letter-spacing:.3em;color:var(–gray-2);
text-transform:uppercase;
}

@media print{
html,body{background:#fff}
.deck{padding:0;gap:0}
.slide{box-shadow:none;page-break-after:always;break-after:page}
}
</style>

</head>
